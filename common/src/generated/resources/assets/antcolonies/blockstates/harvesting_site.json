{
  "multipart": [
    {
      "when": {
        "facing": "north"
      },
      "apply": {
        "model": "antcolonies:block/harvesting_site"
      }
    },
    {
      "when": {
        "facing": "east"
      },
      "apply": {
        "model": "antcolonies:block/harvesting_site",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "south"
      },
      "apply": {
        "model": "antcolonies:block/harvesting_site",
        "y": 180
      }
    },
    {
      "when": {
        "facing": "west"
      },
      "apply": {
        "model": "antcolonies:block/harvesting_site",
        "y": 270
      }
    },
    {
      "when": {
        "north": "false",
        "west": "false"
      },
      "apply": {
        "model": "antcolonies:block/frame/north_west"
      }
    },
    {
      "when": {
